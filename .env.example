# --- Text model (default: GLM-compatible) ---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_TEXT_MODEL=glm-4-flash

# --- Vision model (independent from the text model) ---
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4.6v-flash

# --- Optional generic text provider ---
# Set all three to use a different text supplier; leave all three empty to use GLM_*.
# A partial set is rejected as a configuration error.
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_MODEL=

# --- Explicit capability declarations (never guessed) ---
TEXT_SUPPORTS_TOOLS=true
TEXT_SUPPORTS_JSON=true
VISION_SUPPORTS_VISION=true
VISION_SUPPORTS_TOOLS=false

# --- Local administration and limits ---
APP_ENV=development
# Production uses the separate .env.production.example template.
PUBLIC_ORIGIN=
ALLOWED_HOSTS=
ADMIN_TOKEN=
PUBLIC_REQUESTS_PER_MINUTE=12
ADMIN_REQUESTS_PER_MINUTE=120
MAX_AGENT_STEPS=8
MODEL_TIMEOUT_SECONDS=90
MAX_RUNS_PER_HOUR=30
MAX_QUEUED_RUNS=20
DAILY_MODEL_CALL_LIMIT=300
SESSION_MODEL_CALL_LIMIT=60
BUDGET_TIMEZONE=Asia/Shanghai
BATCH_MAX_PAGES=20
IMPORT_MAX_MEGABYTES=100
IMPORT_MAX_PAGES=1000
IMPORT_MAX_PIXELS=80000000

# --- Deduplication: share identical pages across editions (safe, no model) ---
DEDUP_SHARE_PAGES=true

# Optional pricing table for estimated cost; leave empty to report cost as not configured.
# PRICE_CONFIG_JSON={"glm-4-flash": {"input": 0, "output": 0, "currency": "CNY", "version": "2026-01"}}
PRICE_CONFIG_JSON=
